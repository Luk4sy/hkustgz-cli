{
  "name": "hkustgz-cli",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Read-only campus service CLI for HKUST(GZ) students.",
  "type": "module",
  "bin": {
    "hkustgz-cli": "bin/hkustgz-cli.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --import tsx --test --test-concurrency=2 tests/*.test.ts",
    "start": "node bin/hkustgz-cli.mjs",
    "prepack": "npm run build"
  },
  "files": [
    "bin/hkustgz-cli.mjs",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "docs/installation.md",
    "docs/cli-contract.md",
    "docs/errors.md",
    "skills/hkustgz-cli/SKILL.md",
    "skills/hkustgz-cli/references/commands.md",
    "skills/hkustgz-cli/references/errors.md",
    "skills/hkustgz-cli/references/examples.md",
    "skills/hkustgz-cli/references/privacy.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "15.0.0",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
